{
  "expo": {
    "name": "Podręcznik Modlitwy",
    "slug": "podrecznik-adoracji",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.podrecznik.adoracji"
    },
    "android": {
      "package": "com.podrecznik.adoracji",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#181226"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-status-bar",
      "expo-video",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#181226"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cc0e923f-5387-4753-8ae9-2bdc83dfc12f"
      }
    }
  }
}
